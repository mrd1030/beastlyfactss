/*
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=()
  # If Google Tag Assistant ever reports "the window was closed before a
  # connection could be established" or "page is not tagged", this line is why.
  # Tag Assistant opens the site in a popup and talks to it through
  # window.opener; `same-origin` puts that popup in its own browsing context
  # group, so the opener handle goes null. Temporarily set `unsafe-none` (the
  # browser default) for the duration of the debugging session, then restore
  # this. `same-origin-allow-popups` is NOT the fix: that governs popups this
  # page opens, not how this page behaves when something else opens it.
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Resource-Policy: same-origin
  Cache-Control: public, max-age=0, must-revalidate
  # Google Discover eligibility: allows full-size image previews. A header
  # rather than a robots meta on purpose - generate-fact-pages.mjs forbids a
  # robots meta in the built shell (it injects its own per-fact noindex).
  # Header and page-level meta directives merge, so noindex pages stay noindex.
  X-Robots-Tag: max-image-preview:large

# Images, fonts and scripts under /assets/ are meant to be embedded from other
# origins: the newsletter hotlinks the About photo, Discord and forum posts
# unfurl article images, and the OG image is fetched by every share card.
# The site-wide Cross-Origin-Resource-Policy: same-origin above makes a browser
# refuse those loads (the Beehiiv editor rendered the Dex photo as its alt
# text). Detach the site-wide value and re-set it as cross-origin for static
# assets only. HTML responses keep same-origin.
/assets/*
  ! Cross-Origin-Resource-Policy
  Cross-Origin-Resource-Policy: cross-origin

/assets/*.js
  Cache-Control: public, max-age=31536000, immutable

/assets/*.css
  Cache-Control: public, max-age=31536000, immutable

# Images were falling through to a 1 hour lifetime, which is what PageSpeed's
# "use efficient cache lifetimes" flags: every repeat visitor revalidates all
# ~1,400 of them. 30 days instead.
#
# Deliberately NOT the year-long immutable that .js and .css get above. Those
# filenames carry a content hash, so a changed file is a changed URL and a stale
# cache is impossible. Image filenames are stable (hero-800.avif stays
# hero-800.avif when its contents change), so max-age is a promise we cannot
# take back: whatever number is here is how long an existing visitor can keep
# showing the old bytes after a swap. 30 days is the most that seemed fair to
# trade for that. If an image ever has to change faster than that, rename it and
# update the reference rather than lowering this.
/assets/*.jpg
  Cache-Control: public, max-age=2592000
/assets/*.jpeg
  Cache-Control: public, max-age=2592000
/assets/*.png
  Cache-Control: public, max-age=2592000
/assets/*.webp
  Cache-Control: public, max-age=2592000
/assets/*.avif
  Cache-Control: public, max-age=2592000
/assets/*.svg
  Cache-Control: public, max-age=2592000

# og-default.jpg is the og:image and twitter:image for every page, and its URL
# must never change. Facebook, X, LinkedIn and Slack cache a share card against
# the URL that was live when the link was first posted, so renaming or hashing
# this file breaks the preview on every link anyone has already shared. It is
# deliberately a plain file in public/ for that reason, while the visual hero it
# was cut from is imported through src/assets/ and hashed. Same picture, two
# jobs, opposite requirements: one must change its URL on every edit, the other
# must never change it at all.
#
# public/assets/hero-1200.jpg is kept for the same reason. It was the og:image
# before og-default.jpg took over, so links shared before that swap still point
# at it. Nothing in the app references it any more. Do not delete it.

# The hashed favicon webp. It is no longer the search favicon: index.html now
# declares /favicon.png and /favicon.ico, because Google Search does not read
# WebP for favicons and because the hashed URL moved whenever the image was
# recompressed. This file still ships, since Logo.jsx imports the same webp for
# the on-page mark, and that import is content-hashed the way every src/ asset
# is. A changed file is a changed URL there, so it keeps the year-long immutable
# treatment .js and .css get.
# More specific path, so this wins over /assets/*.webp.
/assets/favicon-*.webp
  Cache-Control: public, max-age=31536000, immutable

# The search favicon, at two paths that must never change. Google's guidance is
# that the favicon URL has to be stable, so unlike everything Vite emits these
# carry no content hash and cannot be given the immutable treatment above: the
# max-age here is how long a visitor keeps showing the old mark after a swap.
# 30 days, matching the other stable-filename images.
#
# The rules above are all /assets/* and never matched these, so before this
# block they fell through to the default short lifetime and every repeat visit
# revalidated the icon.
/favicon.ico
  Cache-Control: public, max-age=2592000
/favicon.png
  Cache-Control: public, max-age=2592000
