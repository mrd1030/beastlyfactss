/*
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  # If Google Tag Assistant ever reports "the window was closed before a
  # connection could be established" or "page is not tagged", this line is why.
  # Tag Assistant opens the site in a popup and talks to it through
  # window.opener; `same-origin` puts that popup in its own browsing context
  # group, so the opener handle goes null. Temporarily set `unsafe-none` (the
  # browser default) for the duration of the debugging session, then restore
  # this. `same-origin-allow-popups` is NOT the fix: that governs popups this
  # page opens, not how this page behaves when something else opens it.
  Cross-Origin-Opener-Policy: same-origin
  Cache-Control: public, max-age=0, must-revalidate

/assets/*.js
  Cache-Control: public, max-age=31536000, immutable

/assets/*.css
  Cache-Control: public, max-age=31536000, immutable
